{
  "name": "mc-pao-ciao-marco",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/game/rules.test.ts",
    "test:game": "node scripts/playtest-story.mjs",
    "test:ui": "node scripts/playtest-ui.mjs",
    "art:pack": "node scripts/prepare-art.mjs",
    "test:mobile": "node scripts/playtest-story.mjs --mobile",
    "test:phones": "node scripts/playtest-mobile.mjs",
    "test:production": "node scripts/playtest-production.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3"
  }
}
